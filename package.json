{
  "name": "interviewee-bot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace api dev\" \"yarn workspace web dev\"",
    "build": "yarn workspace api build && yarn workspace web build",
    "db:migrate": "yarn workspace api db:migrate",
    "db:generate": "yarn workspace api db:generate",
    "test": "yarn workspace api test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
