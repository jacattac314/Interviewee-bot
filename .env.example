# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interviewee_bot

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15550000000

# ─── SendGrid (Email) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_INBOUND_WEBHOOK_KEY=your_signed_event_webhook_key
SENDGRID_FROM_EMAIL=hiring@yourcompany.com
SENDGRID_FROM_NAME=Fairly Hiring Bot

# ─── Anthropic (AI field extraction) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── ATS: Greenhouse ──────────────────────────────────────────────────────────
GREENHOUSE_API_KEY=your_harvest_api_key
GREENHOUSE_WEBHOOK_SECRET=your_greenhouse_webhook_secret
GREENHOUSE_ON_BEHALF_OF=your_greenhouse_user_id

# ─── ATS: Lever ───────────────────────────────────────────────────────────────
LEVER_API_KEY=your_lever_api_key
LEVER_WEBHOOK_TOKEN=your_lever_webhook_token

# ─── Application ──────────────────────────────────────────────────────────────
APP_URL=https://hiring.yourcompany.com
PORT=3001
NODE_ENV=development

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_at_least_32_chars_long_please
REVIEWER_API_KEY=change_me_reviewer_api_key

# ─── Interview settings ────────────────────────────────────────────────────────
# How long (minutes) to wait for a candidate reply before nudging
INTERVIEW_REPLY_TIMEOUT_MINUTES=60
# How long (hours) before session fully times out
INTERVIEW_SESSION_TIMEOUT_HOURS=48
# Max clarifying question retries per message
MAX_CLARIFY_RETRIES=2
